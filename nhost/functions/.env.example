GROQ_API_KEY=
LLM_STUB_DELAY_MS=1500

# The below default to values that work out of the box with `nhost up` for
# local development. Set them explicitly when deploying to nhost cloud or
# any environment where the Hasura GraphQL endpoint, admin secret, or
# functions base URL differ from local defaults.
NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1/graphql
# Nhost supplies NHOST_ADMIN_SECRET automatically; do not hardcode it.
NHOST_FUNCTIONS_URL=https://local.functions.local.nhost.run/v1

# Optional real email notifications via Resend
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# Optional fallback Slack webhook
SLACK_WEBHOOK_URL=
